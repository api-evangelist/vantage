          "request": {
            "name": "Vantage Get Costs",
            "description": {
              "content": "Returns all Costs for a CostReport or VQL filter. You can filter by cost_report_token or provide a VQL query to retrieve specific cost data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "costs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cost_report_token",
                  "value": "<string>",
                  "description": "The token of the Cost Report to retrieve costs for."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "The start date for the cost data (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "The end date for the cost data (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "groupings",
                  "value": "<string>",
                  "description": "Comma-separated list of groupings for cost data."
                },
                {
                  "disabled": false,
                  "key": "vql",
                  "value": "<string>",
                  "description": "A VQL filter expression to query cost data."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The page of results to return."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "The number of results per page."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
