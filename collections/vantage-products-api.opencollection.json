{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vantage Cloud Pricing Access Grants Products API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Products",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vantage Get All Products",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vantage.sh/v1/products",
            "params": [
              {
                "name": "provider_id",
                "value": "500123",
                "type": "query",
                "description": "Filter products by a specific cloud provider identifier."
              },
              {
                "name": "service_id",
                "value": "500123",
                "type": "query",
                "description": "Filter products by a specific service identifier."
              },
              {
                "name": "name",
                "value": "Example Title",
                "type": "query",
                "description": "Filter products by name."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page of results to return."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The number of results per page."
              }
            ]
          },
          "docs": "Returns all Products for a given Provider and Service. For example, with a Provider of AWS and a Service of EC2, Products will be a list of all EC2 instance types with their pricing information."
        },
        {
          "info": {
            "name": "Vantage Get a Product",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vantage.sh/v1/products/:product_id",
            "params": [
              {
                "name": "product_id",
                "value": "500123",
                "type": "path",
                "description": "The identifier of the product."
              }
            ]
          },
          "docs": "Returns a specific Product by identifier with its pricing details."
        }
      ]
    }
  ],
  "bundled": true
}